<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.ResultatPage"
             Title="ResultatPage">
    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="{Binding Message}" FontSize="22" />
        <Label Text="{Binding DaysUntilNextBirthday, StringFormat='Jours jusqu\'au prochain anniversaire : {0}'}" />
        <Button Text="Effacer" Command="{Binding ClearCommand}" />
        <Button Text="Retour" Clicked="onRetourClicked" />
    </VerticalStackLayout>
</ContentPage>